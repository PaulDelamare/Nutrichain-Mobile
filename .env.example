# URL de l'API NutriChain.
# Emulateur Android : http://10.0.2.2:3000 — "localhost" y designe l'emulateur lui-meme.
# Simulateur iOS / web : http://localhost:3000
# Telephone physique : http://<IP-LAN-du-PC>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Doit valoir exactement API_KEY du .env de l'API : /api/auth/* exige ce header.
# Toute variable EXPO_PUBLIC_* est embarquee en clair dans le binaire : cette cle
# est un simple portail (elle n'ouvre aucun droit sans session), jamais un secret.
EXPO_PUBLIC_API_KEY=
