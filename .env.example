# ==============================================================================
# Configuration mobile NutriChain — copiez ce fichier : cp .env.example .env
# ==============================================================================
# L'API NutriChain doit tourner en parallèle (port 3000). Aucun mode n'est imposé :
# choisissez la ligne correspondant à VOTRE façon de lancer l'app et décommentez-la.

# ── URL de l'API ──────────────────────────────────────────────────────────────
# Décommentez UNE seule ligne selon votre cible :
#
#   Émulateur Android (AVD)          : http://10.0.2.2:3000   (10.0.2.2 = l'hôte vu depuis l'émulateur)
#   Simulateur iOS / navigateur web  : http://localhost:3000
#   Téléphone physique via USB       : http://localhost:3000  (nécessite `adb reverse tcp:3000 tcp:3000`)
#   Téléphone physique via Wi-Fi     : http://<IP-LAN-du-PC>:3000  (PC et tél. sur le même réseau)
#
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ── Clé API ───────────────────────────────────────────────────────────────────
# Doit valoir EXACTEMENT la variable `API_KEY` du .env de l'API.
# Elle n'est exigée que sur /api/auth/* (connexion/déconnexion).
# Rappel : toute variable EXPO_PUBLIC_* est embarquée en clair dans le binaire.
# C'est un simple portail d'accès (aucun droit sans session utilisateur), jamais un secret.
#
# La valeur ci-dessous est celle de la pile de démonstration (`docker compose --env-file .env.demo`
# côté API). Laissée vide, la connexion répond 401 « Clé API invalide ou manquante » sans que rien
# n'indique que la cause est ici. Contre une API configurée autrement, recopier SA valeur.
EXPO_PUBLIC_API_KEY=cle-api-de-demo-docker-a-remplacer-en-production
